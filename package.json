{
  "name": "ocean-pulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "dev": "npm run dev --workspaces --parallel",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "db:push": "npm run db:push:sqlite --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "db:push:production": "npm run db:push:postgres --workspace=apps/api",
    "db:seed:production": "npm run db:seed:production --workspace=apps/api",
    "db:generate": "npm run db:generate:sqlite --workspace=apps/api",
    "db:generate:production": "npm run db:generate:postgres --workspace=apps/api"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
